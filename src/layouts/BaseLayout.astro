---
/**
 * Base Layout
 *
 * Shared document shell for every page: SEO metadata, JSON-LD,
 * analytics and (optionally) the site chrome (Header, Navbar, Footer).
 */
import { getImage } from 'astro:assets'
import '@/styles/global.css'
import Header from '@/components/Header.astro'
import Navbar from '@/components/Navbar.astro'
import Footer from '@/components/Footer.astro'
import NavOrderScript from '@/components/NavOrderScript.astro'
import { SITE_URL, SITE_NAME } from '@/lib/site'
import { getRouteLabels, getSiteContent } from '@/lib/content'
import { DEFAULT_LOCALE, type Locale } from '@/lib/locales'
import { socialLinks } from '@/data/socialLinks'
import defaultOgImage from '@/assets/img/home_page.png'

interface Props {
  title?: string
  description?: string
  ogType?: string
  /** Absolute URL of the Open Graph image. Defaults to a screenshot of the home page. */
  ogImage?: string
  ogImageWidth?: number
  ogImageHeight?: number
  /** Locale of the page texts (default: Turkish). */
  locale?: Locale
  /** Text shown in the header. */
  pageTitle?: string
  /** Whether Header, Navbar and Footer render. The home page passes false. */
  showChrome?: boolean
  /** Adds `<meta name="robots" content="noindex">` and omits canonical / og:url (404 page). */
  noindex?: boolean
  /** Emits the JSON-LD Person block (home and about pages only). */
  jsonLd?: boolean
}

const {
  title = SITE_NAME,
  description,
  locale = DEFAULT_LOCALE,
  ogType = 'website',
  ogImage,
  ogImageWidth,
  ogImageHeight,
  pageTitle = '',
  showChrome = true,
  noindex = false,
  jsonLd: withJsonLd = false,
} = Astro.props

const content = await getSiteContent(locale)
const metaDescription = description ?? content.description

// Strip the trailing slash the static build adds (/about/ -> /about) so nav matching,
// canonical and og:url stay identical to the old URLs.
const pathname = Astro.url.pathname.replace(/(.)\/$/, '$1')
const canonicalUrl = new URL(pathname, `${SITE_URL}/`).href

// PNG/JPEG only: not every scraper handles WebP. Width 1200 is the usual OG size.
let image = { url: ogImage, width: ogImageWidth, height: ogImageHeight }
if (!ogImage) {
  const fallback = await getImage({ src: defaultOgImage, width: 1200, format: 'png' })
  image = {
    url: new URL(fallback.src, `${SITE_URL}/`).href,
    width: fallback.attributes.width,
    height: fallback.attributes.height,
  }
}

const navLabels = getRouteLabels(content)

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_NAME,
  url: SITE_URL,
  jobTitle: content.jsonLd.jobTitle,
  affiliation: { '@type': 'CollegeOrUniversity', name: content.jsonLd.affiliation },
  sameAs: socialLinks.map((link) => link.url),
})
---

<!doctype html>
<html lang={content.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={SITE_NAME} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={content.ogLocale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={image.url} />
    {image.width && <meta property="og:image:width" content={String(image.width)} />}
    {image.height && <meta property="og:image:height" content={String(image.height)} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={image.url} />

    <!-- JSON-LD structured data -->
    {withJsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    {
      showChrome && (
        <>
          <Header
            pageTitle={pageTitle}
            pathname={pathname}
            navLabels={navLabels}
            labels={content.header}
          />
          <Navbar pathname={pathname} navLabels={navLabels} />
        </>
      )
    }
    {
      /* Blocking inline script: must stay right after the nav markup. Also runs on pages
        without chrome (home) so every page load records itself as the previous path. */
    }
    <NavOrderScript />
    <div class="flex flex-1 flex-col">
      <slot />
    </div>
    {showChrome && <Footer labels={content.footer} />}
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://umami.metehansenyer.dev/script.js"
          data-website-id="41d22223-daff-461c-bec6-d56ddd7208f6"
        />
      )
    }
  </body>
</html>
