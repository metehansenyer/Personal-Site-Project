---
/**
 * Contact page: email and LinkedIn, content from contactContent / socialLinks.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import { socialLinks } from '@/data/socialLinks'
import { contactContent } from '@/data/contactContent'
import { routes } from '@/data/routes'

const title = 'İletişim | Metehan Şenyer'
const description =
  'Benimle iletişime geçin. İş birliği, proje önerileri veya herhangi bir soru için buradayım.'
const pageTitle = routes.find((r) => r.path === '/contact')!.title

const linkedIn = socialLinks.find((link) => link.name === 'LinkedIn')
---

<BaseLayout title={title} description={description} ogType="website" pageTitle={pageTitle}>
  <main class="flex flex-1 items-center justify-center px-4 py-8 md:px-0 md:py-0">
    <div class="mx-auto w-full max-w-2xl px-4">
      <!-- Contact Card -->
      <div
        class="space-y-6 rounded-(--border-radius-medium) bg-(--nav-background-color) p-5 text-center shadow-lg md:p-6"
      >
        <!-- Title and Description -->
        <h2 class="text-2xl font-bold text-(--text-color) md:text-3xl">{contactContent.title}</h2>
        <p class="text-base text-(--text-color) md:text-lg">{contactContent.description}</p>

        <!-- Contact Links -->
        <div
          class="flex flex-col items-center justify-center gap-4 text-base md:flex-row md:gap-6 md:text-lg"
        >
          <!-- Email Link -->
          <a
            href={`mailto:${contactContent.email}`}
            target="_blank"
            class="break-all text-(--text-color) transition-colors duration-300 hover:text-(--text-color-white)"
            data-umami-event="email-click"
          >
            {contactContent.email}
          </a>
          <!-- LinkedIn Link - Only shown if LinkedIn profile exists -->
          {
            linkedIn && (
              <>
                <span class="hidden text-(--text-color) md:inline">•</span>
                <a
                  href={linkedIn.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-(--text-color) transition-all duration-300 hover:scale-110 hover:text-(--text-color-white)"
                  title={linkedIn.name}
                  data-umami-event="social-link-click"
                  data-umami-event-platform="LinkedIn"
                >
                  <i class={`${linkedIn.icon} text-xl`} aria-hidden="true" />
                  <span>LinkedIn</span>
                </a>
              </>
            )
          }
        </div>

        <!-- Footer Message -->
        <p class="text-sm text-(--text-color)">{contactContent.footerText}</p>
      </div>
    </div>
  </main>
</BaseLayout>
