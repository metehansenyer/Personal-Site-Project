---
/**
 * Contact page: email and LinkedIn; texts from the site content, links from socialLinks.
 * One implementation for every locale (`[...locale]`, see `lib/i18n.ts`).
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import FaIcon from '@/components/FaIcon.astro'
import { socialLinks } from '@/data/socialLinks'
import { getSiteContent } from '@/lib/content'
import { localeStaticPaths } from '@/lib/i18n'
import type { Locale } from '@/lib/locales'
import { CONTACT_EMAIL, documentTitle } from '@/lib/site'

export const getStaticPaths = localeStaticPaths

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const content = await getSiteContent(locale)
const text = content.contact
const route = content.routes.contact
const title = documentTitle(route.metaTitle)
const description = route.description
const pageTitle = route.title

const linkedIn = socialLinks.find((link) => link.name === 'LinkedIn')
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  ogType="website"
  pageTitle={pageTitle}
>
  <main class="flex flex-1 items-center justify-center px-4 py-8 md:px-0 md:py-0">
    <div class="mx-auto w-full max-w-2xl px-4">
      <!-- Contact Card -->
      <div
        class="space-y-6 rounded-(--border-radius-medium) bg-(--nav-background-color) p-5 text-center shadow-lg md:p-6"
      >
        <!-- Title and Description -->
        <h1 class="text-2xl font-bold text-(--text-color) md:text-3xl">{text.heading}</h1>
        <p class="text-base text-(--text-color) md:text-lg">{text.description}</p>

        <!-- Contact Links -->
        <div
          class="flex flex-col items-center justify-center gap-4 text-base md:flex-row md:gap-6 md:text-lg"
        >
          <!-- Email Link -->
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="break-all text-(--text-color) transition-colors duration-300 hover:text-(--text-color-white)"
            data-umami-event="email-click"
          >
            {CONTACT_EMAIL}
          </a>
          <!-- LinkedIn Link - Only shown if LinkedIn profile exists -->
          {
            linkedIn && (
              <>
                <span class="hidden text-(--text-color) md:inline">•</span>
                <a
                  href={linkedIn.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-(--text-color) transition-all duration-300 hover:scale-110 hover:text-(--text-color-white)"
                  title={linkedIn.name}
                  data-umami-event="social-link-click"
                  data-umami-event-platform="LinkedIn"
                >
                  <FaIcon icon={linkedIn.icon} class="text-xl" />
                  <span>LinkedIn</span>
                </a>
              </>
            )
          }
        </div>

        <!-- Footer Message -->
        <p class="text-sm text-(--text-color)">{text.footer}</p>
      </div>
    </div>
  </main>
</BaseLayout>
