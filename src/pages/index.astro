---
/**
 * Home Page
 *
 * Landing page of the portfolio: minimalist centered layout with navigation buttons.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import { getRoute, type SiteRoute } from '@/data/routes'

// Two-row layout for visual balance; hrefs and labels come from routes.ts
const rows: SiteRoute['path'][][] = [['/about', '/portfolio'], ['/contact']]
const navigationButtons = rows.map((row) =>
  row.map((path) => {
    const route = getRoute(path)
    return { href: route.path, text: route.homeLabel ?? route.label }
  }),
)
---

<BaseLayout showChrome={false} jsonLd>
  <main
    class="mx-auto flex min-h-svh w-full max-w-[90%] flex-col justify-center overflow-hidden sm:max-w-[80%] md:min-h-screen"
  >
    <!-- Main Title Section -->
    <h1 class="text-center">
      <span
        class="block text-sm leading-7 tracking-[0.2em] text-(--text-color) sm:text-[1.25rem] md:text-[1.5rem] md:leading-[3.5rem] md:tracking-normal"
      >
        METE
      </span>
      <span
        class="block text-[clamp(3.8rem,15vw,4.75rem)] leading-[0.95] tracking-[-0.04em] text-(--text-color) md:text-[7.5rem] md:leading-[7.5rem] md:tracking-normal"
      >
        BUYRUN
        <br />
        BENİM
      </span>
    </h1>

    <!-- Navigation Section -->
    <nav class="mt-8 flex flex-col gap-3 md:mt-0 md:block">
      {
        navigationButtons.map((row) => (
          <ul class="flex flex-col items-center justify-center gap-3 md:flex-row md:gap-0">
            {row.map((button) => (
              <li class="w-full md:mx-auto md:mt-12 md:w-auto md:max-w-[27rem]">
                <Button
                  href={button.href}
                  width="w-full md:w-[27rem]"
                  height="h-14 md:h-16"
                  fontSize="text-[1.15rem] md:text-[2rem]"
                >
                  {button.text}
                </Button>
              </li>
            ))}
          </ul>
        ))
      }
    </nav>
  </main>
</BaseLayout>
