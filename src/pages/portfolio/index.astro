---
/**
 * Portfolio Page
 *
 * Grid of project cards (1 column on mobile, 2 on tablet, 3 on desktop), sorted by
 * release date (newest first). Shows a message when there are no projects.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import { getRoute } from '@/data/routes'
import { documentTitle } from '@/lib/site'

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.releaseDate.getTime() - a.data.releaseDate.getTime(),
)

const route = getRoute('/portfolio')
const title = documentTitle(route.title)
const description =
  'Geliştirdiğim projeler, açık kaynak katkılarım ve yazılım alanındaki çalışmalarımın detaylı sunumu.'
---

<BaseLayout title={title} description={description} ogType="website" pageTitle={route.title}>
  {
    projects.length === 0 ? (
      <div class="mx-auto w-full max-w-[90%] px-4 py-8 text-center sm:max-w-[85%] md:max-w-[80%]">
        <p class="text-(--text-color) opacity-70">Henüz proje bulunmuyor.</p>
      </div>
    ) : (
      <main class="mx-auto w-full max-w-[90%] px-4 py-8 sm:max-w-[85%] md:max-w-[80%] md:px-0">
        <h1 class="sr-only">{route.title}</h1>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-8 lg:grid-cols-3">
          {projects.map((project, index) => (
            <ProjectCard project={project} priority={index < 3} />
          ))}
        </div>
      </main>
    )
  }
</BaseLayout>
