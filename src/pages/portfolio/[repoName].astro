---
/**
 * Project Detail Page
 *
 * Renders one project of the `projects` content collection: banner, MDX body
 * (with the custom <Icon> / <Callout> components) and a GitHub link.
 */
import { getCollection, render } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import Icon from '@/components/mdx/Icon.astro'
import Callout from '@/components/mdx/Callout.astro'
import { SITE_URL, SITE_NAME } from '@/lib/site'
// Order matters: the overrides must come after github-markdown-css to win the cascade.
import 'github-markdown-css/github-markdown-dark.css'
import '@/styles/markdown-overrides.css'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({
    params: { repoName: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
const { title, description, banner, userName } = project.data

const ogImage = await getImage({ src: banner, width: 1200, format: 'png' })
const ogImageUrl = new URL(ogImage.src, `${SITE_URL}/`).href
---

<BaseLayout
  title={`${title} | ${SITE_NAME}`}
  description={description}
  ogType="article"
  ogImage={ogImageUrl}
  twitterCard="summary_large_image"
  pageTitle={title}
>
  <main class="mx-auto w-full max-w-[980px] px-4 py-6 sm:py-8">
    <div class="space-y-6 sm:space-y-8">
      <!-- Project banner -->
      <div class="relative aspect-video overflow-hidden rounded-lg shadow-lg">
        <Image
          src={banner}
          alt={`${title} banner`}
          widths={[640, 980, 1400, 1960]}
          sizes="(max-width: 1024px) 100vw, 980px"
          priority
          class="h-full w-full object-cover sm:object-contain"
        />
      </div>

      <!-- Project MDX content -->
      <article
        class="markdown-body project-content w-full"
        style="background-color: transparent; color: var(--text-color); overflow-wrap: anywhere;"
      >
        <Content components={{ Icon, Callout }} />
      </article>

      <!-- GitHub repository link -->
      <div class="mt-6">
        <Button
          href={`https://github.com/${userName}/${project.id}`}
          width="w-full"
          height="h-full"
          fontSize="text-[1.05rem] sm:text-[1.3rem]"
          newTab={true}
          umamiEvent="github-view-click"
          umamiEventData={{ project: project.id }}
        >
          GitHub&apos;da Görüntüle
        </Button>
      </div>
    </div>
  </main>
</BaseLayout>
