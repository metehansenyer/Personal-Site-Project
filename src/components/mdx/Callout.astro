---
/**
 * Callout (MDX component)
 *
 * Highlighted note block used in project MDX as `<Callout type="important">...</Callout>`.
 */
const calloutConfig = {
  important: {
    label: 'ⓘ ÖNEMLİ',
    borderClass: 'border-[var(--important-color)]',
    textClass: 'text-[var(--important-color)]',
  },
  warning: {
    label: '⚠️ UYARI',
    borderClass: 'border-[var(--warning-color)]',
    textClass: 'text-[var(--warning-color)]',
  },
  note: {
    label: 'ⓘ NOT',
    borderClass: 'border-[var(--note-color)]',
    textClass: 'text-[var(--note-color)]',
  },
} as const

interface Props {
  type: keyof typeof calloutConfig
}

const config = calloutConfig[Astro.props.type]
---

<div class={`my-4 border-l-[6px] bg-transparent py-2 pr-2 pl-4 ${config.borderClass}`}>
  <p class={`mb-[5px] font-bold ${config.textClass}`}>{config.label}</p>
  <div>
    <slot />
  </div>
</div>
