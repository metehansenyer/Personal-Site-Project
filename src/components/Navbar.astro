---
/**
 * Navbar (desktop)
 *
 * Buttons to the other sections: Home first, then the remaining nav routes without the
 * current page. Hidden on mobile (the Header has the collapsible menu there). The DOM
 * order is adjusted from sessionStorage by `NavOrderScript.astro`.
 */
import Button from '@/components/Button.astro'
import { getNavItems } from '@/lib/navOrder'
import type { RouteLabels } from '@/data/routes'

interface Props {
  pathname: string
  /** Nav link labels (site content `routes.*.label`). */
  navLabels: RouteLabels
}

const { pathname, navLabels } = Astro.props
const navigation = getNavItems(pathname, navLabels)
---

<nav class="bg-background z-50 hidden w-full pt-1 md:block">
  <div class="container mx-auto px-4">
    <div class="flex justify-center gap-8" data-nav-list>
      {
        navigation.map((item) => (
          <Button href={item.href} width="w-[16rem]" height="h-[4rem]" fontSize="text-[2rem]">
            {item.label}
          </Button>
        ))
      }
    </div>
  </div>
</nav>
