---
/**
 * ProjectCard Component
 *
 * A card that displays project information in the portfolio grid.
 * Each card is a clickable link that leads to the project's detail page.
 *
 * Features:
 * - Banner image optimized at build time (astro:assets)
 * - Title and description
 * - Technology tags. Mobile (<md): first 3 tags + "+N". Desktop (md+): only the tags that fit
 *   in one row are shown; when some do not fit, hovering the card slides them out to the
 *   left and slides the remaining tags in from the right.
 *
 * How the tag overflow works: all tags are rendered on the server inside the "visible"
 * group (so without JavaScript they are simply clipped in one row). A tiny script
 * (see bottom) measures an invisible copy of the row and moves the tags that do not fit
 * into the "remaining" group, then sets `data-has-remaining` on the card. The hover
 * animation itself is pure CSS (Tailwind `group-hover` + `group-data-*` variants).
 */
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import icons from '@/data/icons'

interface Props {
  project: CollectionEntry<'projects'>
  /** Eager / high priority image loading for above-the-fold cards. */
  priority?: boolean
}

const { project, priority = false } = Astro.props
const { title, description, banner, technologies } = project.data

const tagClass = 'bg-background inline-block rounded-full px-3 py-1 text-sm'
const mobileTagClass =
  'bg-background inline-block shrink-0 rounded-full px-2 py-1 text-[0.65rem] leading-none whitespace-nowrap sm:text-xs'
---

<div class="group/card block h-auto sm:h-[320px] md:h-[450px]" data-tag-card>
  <a href={`/portfolio/${project.id}`} class="block h-full">
    <article class="flex h-full cursor-pointer flex-col overflow-hidden rounded-lg bg-(--nav-background-color) shadow-lg transition-transform hover:scale-[1.02]">
      <div class="relative h-44 shrink-0 sm:h-32 md:h-48">
        <Image
          src={banner}
          alt={`${title} banner`}
          widths={[400, 640, 800, 1200]}
          sizes="(max-width: 639px) 90vw, (max-width: 1023px) 42vw, 27vw"
          class="absolute inset-0 h-full w-full object-cover"
          priority={priority}
          loading={priority ? 'eager' : 'lazy'}
        />
      </div>

      <div class="flex flex-1 flex-col p-4 sm:p-4 md:h-[calc(450px-12rem)] md:p-6">
        <div class="min-h-0 flex-1">
          <h2 class="mb-2 line-clamp-2 overflow-hidden text-base font-bold text-ellipsis text-(--text-color) sm:text-lg md:mb-4 md:h-14 md:text-2xl">
            {title}
          </h2>

          <p class="mb-3 line-clamp-3 text-xs text-(--text-color) opacity-90 sm:text-sm md:mb-4 md:line-clamp-4 md:text-base">
            {description}
          </p>
        </div>

        <!-- Mobile (<md): first 3 tags + "+N" -->
        <div class="mt-3 flex flex-wrap gap-1.5 md:hidden">
          {technologies.slice(0, 3).map((tech) => (
            <span class={mobileTagClass}>{icons[tech].name}</span>
          ))}
          {technologies.length > 3 && (
            <span class={mobileTagClass}>+{technologies.length - 3}</span>
          )}
        </div>

        <!-- Desktop (md+) -->
        <div class="relative hidden overflow-hidden md:block">
          <!-- Invisible row of all tags: sets the row's intrinsic height and is measured
               by the script to decide how many tags fit before overflowing. -->
          <div
            data-tag-measure
            aria-hidden="true"
            class="pointer-events-none invisible flex gap-2 whitespace-nowrap"
          >
            {technologies.map((tech) => (
              <span data-measure-tag class={tagClass}>
                {icons[tech].name}
              </span>
            ))}
          </div>

          <div class="absolute inset-0 flex gap-2 whitespace-nowrap">
            <div
              data-tag-visible
              class="flex gap-2 transition-all duration-700 ease-in-out group-hover/card:group-data-[has-remaining]/card:-translate-x-full group-hover/card:group-data-[has-remaining]/card:opacity-0"
            >
              {technologies.map((tech) => (
                <span data-tag class={tagClass}>
                  {icons[tech].name}
                </span>
              ))}
            </div>
            <div
              data-tag-remaining
              class="absolute left-0 flex translate-x-full gap-2 opacity-0 transition-all duration-700 ease-in-out group-hover/card:translate-x-0 group-hover/card:opacity-100"
            ></div>
          </div>
        </div>
      </div>
    </article>
  </a>
</div>

<script>
  // One script for every card on the page (Astro bundles and de-duplicates it).
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-tag-card]'))

  function layoutCard(card: HTMLElement) {
    const measure = card.querySelector<HTMLElement>('[data-tag-measure]')
    const visible = card.querySelector<HTMLElement>('[data-tag-visible]')
    const remaining = card.querySelector<HTMLElement>('[data-tag-remaining]')
    if (!measure || !visible || !remaining) return

    // The row is display:none below md; wait until it has a width.
    const containerWidth = measure.clientWidth
    if (containerWidth === 0) return

    // Count how many tags fit in one row (same rule as the old React implementation).
    let fit = 0
    for (const tag of measure.querySelectorAll<HTMLElement>('[data-measure-tag]')) {
      if (tag.offsetLeft + tag.offsetWidth <= containerWidth) fit++
      else break
    }

    const tags = Array.from(card.querySelectorAll<HTMLElement>('[data-tag]'))
    if (card.dataset.tagFit !== String(fit)) {
      card.dataset.tagFit = String(fit)
      // Re-append in index order so the original order is kept inside each group.
      visible.append(...tags.slice(0, fit))
      remaining.append(...tags.slice(fit))
    }
    card.toggleAttribute('data-has-remaining', fit < tags.length)
  }

  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const card = entry.target.closest<HTMLElement>('[data-tag-card]')
      if (card) layoutCard(card)
    }
  })

  for (const card of cards) {
    layoutCard(card)
    const measure = card.querySelector('[data-tag-measure]')
    if (measure) observer.observe(measure)
  }

  // Web fonts change tag widths without changing the row width.
  void document.fonts?.ready.then(() => cards.forEach(layoutCard))
</script>
